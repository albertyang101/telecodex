TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
CODEX_API_KEY=
# Optional absolute path to a Codex CLI binary used by the SDK spawn layer.
# Example: CODEX_PATH=/opt/homebrew/bin/codex
CODEX_PATH=
CODEX_MODEL=
CODEX_REASONING_EFFORT=
MAX_FILE_SIZE=20971520
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never
# Optional extra profiles for /launch_profiles, e.g. [{"id":"review","label":"Review","sandboxMode":"workspace-write","approvalPolicy":"on-request"}]
CODEX_LAUNCH_PROFILES_JSON=
CODEX_DEFAULT_LAUNCH_PROFILE=default
# Set to true to expose the built-in Full Access profile and allow extra danger-full-access profiles.
ENABLE_UNSAFE_LAUNCH_PROFILES=false
TOOL_VERBOSITY=summary
# Set to false to buffer Codex agent text and only send the final response to Telegram.
STREAM_AGENT_RESPONSES=true
SHOW_TURN_TOKEN_USAGE=false
ENABLE_TELEGRAM_LOGIN=true
ENABLE_TELEGRAM_REACTIONS=false
TELEGRAM_TRANSPORT_MCP_ENABLED=false
TELEGRAM_TRANSPORT_MCP_AUTO_APPROVE_SENDS=false
TELEGRAM_TRANSPORT_MCP_SERVER_NAME=telegram_transport
TELEGRAM_TRANSPORT_PERSONAS_STATE_PATH=
TELEGRAM_TRANSPORT_BLOCKED_PERSONA_PREFIXES=dadamia_
TELEGRAM_TRANSPORT_MCP_STARTUP_TIMEOUT_MS=10000
TELEGRAM_TRANSPORT_MCP_TOOL_TIMEOUT_MS=30000
VOICE_TRANSCRIPTION_BACKEND=auto
QWEN_ASR_SOCKET=
QWEN_ASR_CONTEXT=
QWEN_ASR_LANGUAGE=
QWEN_ASR_TIMEOUT_MS=
TELEGRAM_FILE_DOWNLOAD_TIMEOUT_MS=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIPTION_TIMEOUT_MS=
